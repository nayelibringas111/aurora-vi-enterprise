# Entorno
ENVIRONMENT=development            # development | production

# Base de datos
# Desarrollo local (por defecto): sqlite:///./aurora.db
# Supabase (Connect → Session pooler, puerto 5432):
# DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./aurora.db

# Seguridad (mínimo 32 caracteres). Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-48-caracteres-o-mas
ACCESS_TOKEN_MINUTES=480

# CORS: dominios del frontend separados por coma
CORS_ORIGINS=http://localhost:5173
# Opcional: permitir previews de Vercel
CORS_ORIGIN_REGEX=

# Datos semilla
AUTO_SEED=true
SEED_DEMO_DATA=true                # false => solo crea el administrador de ADMIN_EMAIL/ADMIN_PASSWORD
ADMIN_EMAIL=admin@auroravi.com
ADMIN_PASSWORD=Admin123!

# Negocio
TAX_RATE=0.18
CURRENCY=PEN
COMPANY_NAME=Distribuidora Andina S.A.C.
